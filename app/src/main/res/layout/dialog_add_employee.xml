<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HỒ SƠ NHÂN VIÊN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <ImageView
                android:id="@+id/imgDialogAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_avatar_default"
                android:background="?attr/colorSecondaryContainer" />
        </androidx.cardview.widget.CardView>

        <TextView android:text="Mã nhân viên" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtMaNv"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp"
            android:hint="Nhập mã nhân viên"
            android:textColorHint="?android:attr/textColorSecondary" />

        <TextView android:text="Họ và tên" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtHoTen"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp"
            android:hint="Nhập đầy đủ họ tên" />

        <TextView android:text="Ngày sinh" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtNgaySinh"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="16dp"
            android:hint="Bấm để chọn ngày sinh"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

        <TextView android:text="Giới tính" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:layout_marginBottom="16dp">
            <Spinner
                android:id="@+id/spinnerGioiTinh"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView android:text="Số điện thoại" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtSoDt"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:inputType="phone"
            android:layout_marginBottom="16dp"
            android:hint="Nhập số điện thoại" />

        <TextView android:text="Email" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"
            android:hint="example@gmail.com" />

        <TextView android:text="Phòng ban" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:layout_marginBottom="16dp">
            <Spinner
                android:id="@+id/spinnerPhongBan"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView android:text="Chức vụ" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtChucVu"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="16dp"
            android:hint="Ví dụ: Trưởng phòng" />

        <TextView android:text="Ngày vào làm" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <EditText
            android:id="@+id/edtNgayVaoLam"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="16dp"
            android:textColor="?android:attr/textColorPrimary"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="16dp"
            android:hint="Bấm để chọn ngày"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

        <TextView android:text="Hệ số lương" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_input_all"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/edtHeSoLuong"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:inputType="numberDecimal"
                android:text="1.0"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_toStartOf="@+id/layoutArrows"/>

            <LinearLayout
                android:id="@+id/layoutArrows"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_margin="1dp"
                android:orientation="vertical"
                android:background="@drawable/bg_input_all"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnPlusHeSo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="center"
                    android:src="@android:drawable/arrow_up_float"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorPrimary" />

                <View
                    android:layout_width="24dp"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:alpha="0.5" />

                <ImageView
                    android:id="@+id/btnMinusHeSo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scaleType="center"
                    android:src="@android:drawable/arrow_down_float"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorPrimary" />

            </LinearLayout>
        </RelativeLayout>

        <TextView android:text="Trạng thái" android:textColor="?attr/colorPrimary" android:textSize="11sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="4dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_all"
            android:layout_marginBottom="24dp">
            <Spinner
                android:id="@+id/spinnerTrangThai"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            <Button
                android:id="@+id/btnCloseEmployeeDialog"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hủy"
                android:textColor="?android:attr/textColorSecondary" />
            <Button
                android:id="@+id/btnSaveEmployee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Lưu hồ sơ"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>