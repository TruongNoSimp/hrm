<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN NHÂN VIÊN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">
            <ImageView
                android:id="@+id/imgDialogAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_avatar_default"
                android:scaleType="centerCrop"
                android:background="#EEEEEE" />
        </androidx.cardview.widget.CardView>

        <TextView android:text="Mã nhân viên" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtMaNv"
            style="@style/InputStyle"
            android:hint="Nhập mã nhân viên" />

        <TextView android:text="Họ và tên" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtHoTen"
            style="@style/InputStyle"
            android:hint="Nhập đầy đủ họ tên" />

        <TextView android:text="Ngày sinh" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtNgaySinh"
            style="@style/InputStyle"
            android:hint="Bấm để chọn ngày sinh"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

        <TextView android:text="Giới tính" style="@style/LabelStyle" />
        <FrameLayout style="@style/InputStyle">
            <Spinner
                android:id="@+id/spinnerGioiTinh"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView android:text="Số điện thoại" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtSoDt"
            style="@style/InputStyle"
            android:hint="Nhập số điện thoại"
            android:inputType="phone" />

        <TextView android:text="Email" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtEmail"
            style="@style/InputStyle"
            android:hint="example@gmail.com"
            android:inputType="textEmailAddress" />

        <TextView android:text="Phòng ban" style="@style/LabelStyle" />
        <FrameLayout style="@style/InputStyle">
            <Spinner
                android:id="@+id/spinnerPhongBan"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView android:text="Chức vụ" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtChucVu"
            style="@style/InputStyle"
            android:hint="Ví dụ: Trưởng phòng" />

        <TextView android:text="Ngày vào làm" style="@style/LabelStyle" />
        <EditText
            android:id="@+id/edtNgayVaoLam"
            style="@style/InputStyle"
            android:hint="Bấm để chọn ngày"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

        <TextView
            android:text="Hệ số lương"
            style="@style/LabelStyle" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/edtHeSoLuong"
                style="@style/InputStyle"
                android:layout_width="match_parent"
                android:hint="Ví dụ: 2.34"
                android:inputType="numberDecimal"
                android:paddingEnd="45dp"
                android:text="1.0" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignTop="@id/edtHeSoLuong"
                android:layout_alignBottom="@id/edtHeSoLuong"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnPlusHeSo"
                    android:layout_width="24dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/arrow_up_float"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Tăng"
                    app:tint="#1A73E8" />

                <ImageView
                    android:id="@+id/btnMinusHeSo"
                    android:layout_width="24dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="Giảm"
                    app:tint="#D32F2F" />
            </LinearLayout>
        </RelativeLayout>

        <TextView android:text="Trạng thái" style="@style/LabelStyle" />
        <FrameLayout style="@style/InputStyle" android:layout_marginBottom="24dp">
            <Spinner
                android:id="@+id/spinnerTrangThai"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCloseEmployeeDialog"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Hủy"
                android:textColor="#666666" />

            <Button
                android:id="@+id/btnSaveEmployee"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="Lưu hồ sơ"
                android:backgroundTint="#1A73E8"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>