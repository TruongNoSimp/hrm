<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN NHÂN VIÊN"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">
            <ImageView
                android:id="@+id/imgDialogAvatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_avatar_default"
                android:scaleType="centerCrop"
                android:background="?android:attr/listDivider" />
        </androidx.cardview.widget.CardView>

        <TextView android:text="MÃ NHÂN VIÊN" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtMaNv"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Ví dụ: NV001" />

        <TextView android:text="HỌ VÀ TÊN" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtHoTen"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Nhập đầy đủ họ tên" />

        <TextView android:text="NGÀY SINH" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtNgaySinh"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Bấm để chọn ngày sinh"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            app:drawableTint="?android:attr/textColorSecondary" />

        <TextView android:text="GIỚI TÍNH" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <FrameLayout style="@style/InputStyle" android:background="@drawable/bg_input_all">
            <Spinner
                android:id="@+id/spinnerGioiTinh"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView android:text="SỐ ĐIỆN THOẠI" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtSoDt"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Nhập số điện thoại"
            android:inputType="phone" />

        <TextView android:text="ĐỊA CHỈ EMAIL" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtEmail"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="example@gmail.com"
            android:inputType="textEmailAddress" />

        <TextView android:text="PHÒNG BAN" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <FrameLayout style="@style/InputStyle" android:background="@drawable/bg_input_all">
            <Spinner
                android:id="@+id/spinnerPhongBan"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView android:text="CHỨC VỤ" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtChucVu"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Ví dụ: Nhân viên kinh doanh" />

        <TextView android:text="NGÀY VÀO LÀM" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtNgayVaoLam"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Bấm để chọn ngày"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            app:drawableTint="?android:attr/textColorSecondary" />

        <TextView android:text="HỆ SỐ LƯƠNG" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <EditText
            android:id="@+id/edtHeSoLuong"
            style="@style/InputStyle"
            android:background="@drawable/bg_input_all"
            android:textColor="?android:attr/textColorPrimary"
            android:hint="Ví dụ: 2.34"
            android:inputType="numberDecimal" />

        <TextView android:text="TRẠNG THÁI LÀM VIỆC" style="@style/LabelStyle" android:textColor="?attr/colorPrimary" />
        <FrameLayout style="@style/InputStyle" android:background="@drawable/bg_input_all" android:layout_marginBottom="32dp">
            <Spinner
                android:id="@+id/spinnerTrangThai"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btnCloseEmployeeDialog"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Hủy"
                android:textColor="?android:attr/textColorSecondary" />

            <Button
                android:id="@+id/btnSaveEmployee"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:text="Lưu hồ sơ"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="?attr/colorOnPrimary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>