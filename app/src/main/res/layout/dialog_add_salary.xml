<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THÔNG TIN LƯƠNG"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <TextView
            android:text="Nhân viên"
            style="@style/LabelStyle" />

        <FrameLayout style="@style/InputStyle">
            <Spinner
                android:id="@+id/spNhanVien"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:text="Tháng"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/edtThangNam"
            style="@style/InputStyle"
            android:hint="Bấm để chọn tháng"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

        <TextView
            android:text="Phụ cấp"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/edtPhuCap"
            style="@style/InputStyle"
            android:hint="Nhập phụ cấp"
            android:inputType="numberDecimal" />

        <TextView
            android:text="Khấu trừ"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/edtKhauTru"
            style="@style/InputStyle"
            android:hint="Nhập khấu trừ"
            android:inputType="numberDecimal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnCloseSalaryDialog"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Hủy"
                android:textColor="#666666" />

            <Button
                android:id="@+id/btnSaveSalary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:text="Lưu lương"
                android:backgroundTint="#1A73E8"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>