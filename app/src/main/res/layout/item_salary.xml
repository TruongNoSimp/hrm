<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvNhanVien"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhân viên: NV01 - Nguyễn Văn A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvThangNam"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tháng: 04/2026"
            android:textSize="15sp"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvNgayCong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ngày công: 26"
            android:textSize="14sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tvThuong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Thưởng: 500,000"
            android:textSize="14sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tvPhat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Phạt: 100,000"
            android:textSize="14sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/tvTongLuong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tổng lương: 8,500,000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgEditSalary"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Sửa"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_edit" />

            <ImageView
                android:id="@+id/imgDeleteSalary"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="20dp"
                android:contentDescription="Xóa"
                android:padding="2dp"
                android:src="@android:drawable/ic_menu_delete" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>